---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { es } from '@/i18n/es';

const copy = es;
---

<BaseLayout copy={copy} lang="es" page="privacy" canonical="https://gruponasacero.com/privacidad/">
  <Header copy={copy} lang="es" activePage="home" />
  <main id="main-content" class="section-pad bg-crema min-h-[60vh]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="eyebrow mb-4 block">Legal</span>
      <h1 class="text-navy mb-8" style="font-size:2rem;">Aviso de Privacidad</h1>
      <div class="prose prose-navy max-w-none" style="text-transform:none;letter-spacing:normal;">
        <p class="text-muted leading-relaxed mb-6">
          <strong>Grupo Nasacero</strong> (que incluye a Nacional de Anclas, Nasacero y JP Rentals), con domicilio en Anastacio Bustamante 1030 / 1048 Poniente, Bella Vista, Monterrey, N.L., C.P. 64410, México, es responsable del tratamiento de sus datos personales.
        </p>
        <h2 class="text-navy text-lg font-black uppercase tracking-wide mb-3 mt-8">Datos que recabamos</h2>
        <p class="text-muted leading-relaxed mb-4">Recabamos nombre, empresa, correo electrónico y teléfono con la finalidad de atender solicitudes comerciales y de servicio al cliente. No compartimos sus datos con terceros sin su consentimiento.</p>
        <h2 class="text-navy text-lg font-black uppercase tracking-wide mb-3 mt-8">Finalidad</h2>
        <p class="text-muted leading-relaxed mb-4">Sus datos se utilizan exclusivamente para dar seguimiento a consultas y solicitudes de cotización relacionadas con los servicios de Grupo Nasacero y sus empresas.</p>
        <h2 class="text-navy text-lg font-black uppercase tracking-wide mb-3 mt-8">Derechos ARCO</h2>
        <p class="text-muted leading-relaxed mb-4">Puede ejercer sus derechos de acceso, rectificación, cancelación u oposición enviando un correo a <a href="mailto:info@nasacero.com" class="text-coral hover:opacity-80">info@nasacero.com</a>.</p>
        <h2 class="text-navy text-lg font-black uppercase tracking-wide mb-3 mt-8">Cambios al aviso</h2>
        <p class="text-muted leading-relaxed">Nos reservamos el derecho a modificar este aviso de privacidad en cualquier momento. Las modificaciones estarán disponibles en este sitio web.</p>
      </div>
    </div>
  </main>
  <Footer copy={copy} lang="es" />
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppFloat from '@/components/WhatsAppFloat.astro';
import { en } from '@/i18n/en';

const copy = en;
const c = copy.contact;
const cta = copy.cta;
---

<BaseLayout copy={copy} lang="en" page="contact" canonical="https://gruponasacero.com/en/contact/">
  <Header copy={copy} lang="en" activePage="contact" />

  <main id="main-content">

    <!-- Hero -->
    <section class="bg-navy-deep py-20 md:py-28 relative overflow-hidden" aria-labelledby="contact-hero-en-title">
      <div class="absolute inset-0" aria-hidden="true">
        <div class="absolute inset-0" style="background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px); background-size: 60px 60px;"></div>
      </div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <span class="eyebrow text-coral/80 mb-4 block">{c.hero.eyebrow}</span>
        <h1 id="contact-hero-en-title" class="text-white font-black uppercase mb-6"
            style="font-size: clamp(2rem, 1.5rem + 2.5vw, 3.5rem); letter-spacing:0.05em; line-height:1.1;">
          {c.hero.title}
        </h1>
        <p class="text-white/65 text-lg leading-relaxed max-w-xl"
           style="text-transform:none;letter-spacing:normal;font-weight:400;">
          {c.hero.sub}
        </p>
      </div>
    </section>

    <!-- Contact grid -->
    <section class="section-pad bg-crema" aria-label="Contact information">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

          <!-- Info col -->
          <div class="flex flex-col gap-8 gn-fade">
            <div class="gn-card p-8">
              <div class="w-10 h-10 rounded-lg bg-coral/10 flex items-center justify-center text-coral mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.38 2 2 0 0 1 3.58 1h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.91 8.91a16 16 0 0 0 6.16 6.16l.87-.87a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              </div>
              <h3 class="text-navy font-black text-sm uppercase tracking-[0.08em] mb-4">{cta.label1}</h3>
              {c.info.phones.map(p => (
                <div class="mb-4 last:mb-0">
                  <a href={p.href} class="text-navy font-bold text-lg hover:text-coral transition-colors block">{p.display}</a>
                  <span class="text-muted text-xs">{p.name}</span>
                </div>
              ))}
            </div>

            <div class="gn-card p-8">
              <div class="w-10 h-10 rounded-lg bg-navy/8 flex items-center justify-center text-navy mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </div>
              <h3 class="text-navy font-black text-sm uppercase tracking-[0.08em] mb-4">{cta.label2}</h3>
              {c.info.emails.map(email => (
                <a href={`mailto:${email}`} class="block text-navy hover:text-coral transition-colors font-medium text-sm mb-2">{email}</a>
              ))}
            </div>

            <div class="gn-card p-8">
              <div class="w-10 h-10 rounded-lg bg-mustard/15 flex items-center justify-center text-mustard-dark mb-5">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <h3 class="text-navy font-black text-sm uppercase tracking-[0.08em] mb-4">{cta.label3}</h3>
              {c.info.address.map(line => (
                <span class="block text-muted text-sm leading-relaxed">{line}</span>
              ))}
              <a href={c.info.mapHref} target="_blank" rel="noopener noreferrer"
                 class="inline-flex items-center gap-1.5 text-coral text-xs font-semibold uppercase tracking-[0.12em] mt-4 hover:opacity-80 transition-opacity">
                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                {cta.mapLabel}
              </a>
            </div>
          </div>

          <!-- Right col -->
          <div class="lg:col-span-2 gn-fade" style="transition-delay:100ms">
            <div class="gn-card p-8 md:p-10">
              <h2 class="text-navy mb-2" style="font-size:1.3rem;">Write to us directly</h2>
              <p class="text-muted text-sm mb-8" style="text-transform:none;letter-spacing:normal;font-weight:400;">
                Select the group company based on your need and write to the corresponding email.
              </p>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-10">
                {copy.companies.items.map((company, i) => {
                  const emails = ['info@nacionaldeanclas.com', 'info@nasacero.com', 'info@nasacero.com'];
                  const subjects = [
                    'Inquiry — Foundation anchors (Nacional de Anclas)',
                    'Inquiry — Steel plate cutting (Nasacero)',
                    'Inquiry — Structure & cladding (JP Rentals)',
                  ];
                  return (
                    <a href={`mailto:${emails[i]}?subject=${encodeURIComponent(subjects[i])}`}
                       class="p-5 rounded-xl border flex flex-col gap-3 hover:border-coral/30 hover:shadow-card transition-all duration-200 group bg-crema"
                       style="border-color: rgba(26,38,64,0.1);">
                      <span class="eyebrow text-muted group-hover:text-coral transition-colors">{company.tagline}</span>
                      <span class="text-navy font-black text-sm uppercase tracking-[0.06em] group-hover:text-coral transition-colors">{company.name}</span>
                      <span class="text-xs text-muted/70 flex items-center gap-1 mt-auto" style="text-transform:none;letter-spacing:normal;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                        Write by email
                      </span>
                    </a>
                  );
                })}
              </div>
              <div class="flex items-center gap-4 mb-8">
                <div class="h-px flex-1 bg-navy/10"></div>
                <span class="text-xs text-muted uppercase tracking-[0.12em] font-semibold">or contact via</span>
                <div class="h-px flex-1 bg-navy/10"></div>
              </div>
              <div class="flex flex-wrap gap-4">
                {cta.phones.map(p => (
                  <a href={p.href} class="btn-ghost flex-1 min-w-[160px] flex-col !gap-0.5 !py-3">
                    <span class="text-base font-black">{p.display}</span>
                    <span class="text-xs font-normal opacity-60" style="text-transform:none;">{p.name}</span>
                  </a>
                ))}
                <a href={`https://wa.me/528116007864?text=${encodeURIComponent('Hello, I would like information about Grupo Nasacero services.')}`}
                   target="_blank" rel="noopener noreferrer"
                   class="flex-1 min-w-[160px] inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg font-semibold text-white text-sm hover:opacity-90 transition-opacity"
                   style="background:#25D366;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
                  WhatsApp
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <Footer copy={copy} lang="en" />
  <WhatsAppFloat lang="en" />
</BaseLayout>

---
import type { Copy } from '@/i18n/es';
interface Props { copy: Copy; }
const { copy } = Astro.props;
const s = copy.capabilities;

// Imágenes representativas por capacidad
const images: Record<string, { src: string; alt: string }> = {
  anchor:   { src: '/images/empresas/jprentals-grua-2.webp',   alt: 'Maniobra con grúa — JP Rentals' },
  cut:      { src: '/images/empresas/nasacero-laser.webp',     alt: 'Corte láser CNC — Nasacero' },
  building: { src: '/images/empresas/jprentals-montaje.webp',  alt: 'Montaje estructural — JP Rentals' },
  shield:   { src: '/images/empresas/jprentals-soldadura.webp',alt: 'Soldadura certificada — JP Rentals' },
  map:      { src: '/images/empresas/jprentals-grua-6.webp',   alt: 'Operación industrial — JP Rentals' },
  clock:    { src: '/images/empresas/nasacero-doblez.webp',    alt: 'Doblez en frío — Nasacero' },
};
---

<section class="section-pad bg-white" aria-labelledby="capabilities-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="max-w-2xl mb-16 gn-fade">
      <span class="eyebrow">{s.eyebrow}</span>
      <h2 class="text-navy mt-3 mb-4">{s.title}</h2>
      <p class="text-muted leading-relaxed" style="text-transform:none;letter-spacing:normal;font-weight:400;">
        {s.intro}
      </p>
    </div>

    <!-- Grid de capacidades -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {s.items.map((item, i) => {
        const img = images[item.icon];
        return (
          <div class="cap-card rounded-xl border border-navy/8 overflow-hidden gn-fade" style={`transition-delay:${i*70}ms`}>
            <!-- Imagen representativa -->
            <div class="cap-card__img">
              <img
                src={img.src}
                alt={img.alt}
                loading="lazy"
                decoding="async"
                width="560"
                height="320"
              />
            </div>
            <!-- Contenido -->
            <div class="p-6 bg-crema/60">
              <h3 class="text-navy font-black text-base mb-2 uppercase tracking-[0.06em]">{item.title}</h3>
              <p class="text-muted text-sm leading-relaxed" style="text-transform:none;letter-spacing:normal;font-weight:400;">{item.body}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .cap-card {
    background: var(--color-crema, #f0ede8);
  }

  .cap-card__img {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .cap-card__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    transform: translateZ(0);
  }

  .cap-card:hover .cap-card__img img {
    transform: scale(1.05);
  }

  @media (max-width: 640px) {
    .cap-card__img {
      height: 180px;
    }
  }
</style>

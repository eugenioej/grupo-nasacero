---
import type { Copy } from '@/i18n/es';
interface Props { copy: Copy; }
const { copy } = Astro.props;
const s = copy.whyUs;
---

<section class="section-pad" style="background: linear-gradient(135deg, #1a2640 0%, #0f172a 60%, #1a2640 100%);" aria-labelledby="whyus-title">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="max-w-xl mb-14 gn-fade">
      <span class="eyebrow">{s.eyebrow}</span>
      <h2 id="whyus-title" class="text-white mt-3">{s.title}</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {s.items.map((item, i) => (
        <div class={`p-8 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-sm gn-fade`} style={`transition-delay:${i*90}ms`}>
          <div class="flex items-start gap-5">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-coral/20 flex items-center justify-center mt-0.5">
              <span class="text-coral font-black text-lg leading-none">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div>
              <h3 class="text-white font-black text-base uppercase tracking-[0.05em] mb-3">{item.title}</h3>
              <p class="text-white/60 text-sm leading-relaxed" style="text-transform:none;letter-spacing:normal;font-weight:400;">{item.body}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
